{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/index.html", "/manifest.webmanifest", "/*.css", "/*.js"]
      }
    },
    {
      "name": "recursos",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/media/**", "/*.png", "/*.svg", "/*.ico"]
      }
    }
  ]
}
